{
  "name": "temple-aviv-judea",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "prebuild": "pnpm run generate:tina-types && rm -rf public/admin",
    "dev": "astro dev",
    "dev:cms": "TINA_CMS=true tinacms dev -c \"astro dev\"",
    "build": "pnpm run validate:content && astro check && astro build",
    "build:cms:local": "TINA_CMS=true tinacms build --local --skip-cloud-checks -c \"pnpm run validate:content && astro check && astro build\"",
    "build:cloudflare": "TINA_CMS=true tinacms build --content=local -c \"pnpm run validate:content && astro check && astro build\"",
    "check": "astro check",
    "generate:tina-types": "tinacms build --local --skip-cloud-checks --skip-indexing --noTelemetry -c \"true\"",
    "preview": "astro preview",
    "types:cloudflare": "wrangler types",
    "test:hero-video": "node --test tests/mobile-hero-video.test.mjs tests/hero-media-range.test.mjs",
    "test:navigation-scroll": "node --test tests/navigation-scroll.test.mjs",
    "validate:content": "node scripts/validate-content.mjs && pnpm run verify:hero-video && pnpm run test:navigation-scroll",
    "verify:hero-video": "node scripts/verify-hero-media.mjs && pnpm run test:hero-video"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/tabler": "^1.2.35",
    "@tinacms/astro": "^0.6.1",
    "astro": "^7.1.3",
    "astro-icon": "^1.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@tinacms/cli": "^2.5.6",
    "@types/node": "^24.10.13",
    "tinacms": "^3.11.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  }
}
