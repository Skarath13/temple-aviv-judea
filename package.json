{
	"name": "temple-aviv-judea",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": "22.x || 24.x"
	},
	"scripts": {
		"dev": "tinacms dev -c \"astro dev\"",
		"build": "tinacms build --content=local -c \"astro build\"",
		"build:local": "tinacms build --local --skip-cloud-checks -c \"astro build\"",
		"preview": "astro preview",
		"format": "bunx --bun @biomejs/biome format --write",
		"lint": "bunx --bun @biomejs/biome lint --write",
		"check": "bunx --bun @biomejs/biome check --write",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.1.4",
		"@astrojs/mdx": "^7.0.7",
		"@astrojs/node": "^11.1.4",
		"@astrojs/sitemap": "^3.7.3",
		"@iconify-json/tabler": "^1.2.35",
		"@tinacms/astro": "^0.6.1",
		"astro": "^7.1.3",
		"astro-icon": "^1.1.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.7",
		"@biomejs/biome": "2.5.10",
		"@tinacms/cli": "^2.5.6",
		"@types/node": "^24.10.13",
		"tinacms": "^3.11.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"typescript": "^5.9.3",
		"wrangler": "^4.114.0"
	}
}
