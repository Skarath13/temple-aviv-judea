---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  title: string;
  intro: string;
  accent?: 'blue' | 'coral' | 'gold' | 'teal';
  data?: Record<string, unknown> | null;
}
const { title, intro, accent = 'blue', data } = Astro.props;
---

<section class={`page-hero page-hero-${accent}`}>
  <div class="shell page-hero-inner">
    <h1 data-tina-field={tinaField(data, 'title')}>{title}</h1>
    <p data-tina-field={tinaField(data, 'intro')}>{intro}</p>
  </div>
</section>
