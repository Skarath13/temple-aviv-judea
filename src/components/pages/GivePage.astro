---
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageGive } from '../../../tina/__generated__/types';
import CmsSections from '../CmsSections.astro';
import PageHero from '../PageHero.astro';
import SiteIcon from '../SiteIcon.astro';
import { site } from '../../data/site';
import { cmsImageSource } from '../../lib/cms';

interface Props {
  page: PageGive;
}

const { page } = Astro.props;
const hero = page.hero!;
const banner = page.banner!;
const givingIntro = page.givingIntro!;
const supportPanel = page.supportPanel!;
const trustIcons = ['shield-check', 'lock'] as const;
---

<PageHero eyebrow={hero.eyebrow} title={hero.title} intro={hero.intro} accent={hero.accent as 'blue' | 'coral' | 'gold' | 'teal'} data={hero} />

<section class="mosaic-feature mosaic-gold" aria-label="Giving artwork">
  <div class="shell mosaic-frame" data-reveal="wipe">
    <img src={cmsImageSource(banner.image)} alt={banner.imageAlt} width="1800" height="630" data-tina-field={tinaField(banner, 'image')} />
  </div>
</section>

<section class="section give-section">
  <div class="shell give-grid" data-stagger>
    <div>
      <span class="eyebrow" data-tina-field={tinaField(givingIntro, 'eyebrow')}>{givingIntro.eyebrow}</span>
      <h2 data-tina-field={tinaField(givingIntro, 'heading')}>{givingIntro.heading}</h2>
      <p class="lead" data-tina-field={tinaField(givingIntro, 'lead')}>{givingIntro.lead}</p>
      <p data-tina-field={tinaField(givingIntro, 'body')}>{givingIntro.body}</p>
      <div class="paypal-give-panel">
        <div class="paypal-button-grid" data-tina-field={tinaField(givingIntro, 'donationOptions')}>
          {givingIntro.donationOptions?.map((option) => (
            <a class="paypal-give-button" href={site.giving} target="_blank" rel="noreferrer" aria-label={`Donate to ${option} with PayPal. Opens in a new tab.`}>
              <span><SiteIcon name="brand-paypal" size={27} /><span class="paypal-button-copy"><small>Donate with PayPal</small><strong>{option}</strong></span></span>
              <SiteIcon name="external-link" size={18} />
            </a>
          ))}
        </div>
        <ul class="paypal-trust-list" aria-label="PayPal donation security" data-tina-field={tinaField(givingIntro, 'trustPoints')}>
          {givingIntro.trustPoints?.map((point, index) => <li><SiteIcon name={trustIcons[index] || 'shield-check'} size={20} />{point}</li>)}
        </ul>
        <p class="security-note" data-tina-field={tinaField(givingIntro, 'securityNote')}>{givingIntro.securityNote}</p>
      </div>
    </div>
    <aside class="give-card">
      <img class="give-photo" src={cmsImageSource(supportPanel.image)} alt={supportPanel.imageAlt} width="1280" height="853" data-tina-field={tinaField(supportPanel, 'image')} />
      <div class="give-card-body">
        <span class="eyebrow eyebrow-light" data-tina-field={tinaField(supportPanel, 'eyebrow')}>{supportPanel.eyebrow}</span>
        <ul data-tina-field={tinaField(supportPanel, 'items')}>
          {supportPanel.items?.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>)}
        </ul>
      </div>
    </aside>
  </div>
</section>

<CmsSections sections={page.sections} />
