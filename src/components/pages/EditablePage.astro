---
import type {
	EventScheduleQuery,
	PageBeliefs,
	PageHome,
	PageMinistries,
	PageQuery,
	PageStory,
	SiteSettingsQuery,
} from "../../../tina/__generated__/types";
import type { PageKey } from "../../data/pages";
import BeliefsPage from "./BeliefsPage.astro";
import HomePage from "./HomePage.astro";
import MinistriesPage from "./MinistriesPage.astro";
import StoryPage from "./StoryPage.astro";

interface Props {
	page: PageQuery["page"];
	pageKey: PageKey;
	site: SiteSettingsQuery["siteSettings"];
	eventSchedule: EventScheduleQuery["eventSchedule"];
}

const { page, pageKey, site, eventSchedule } = Astro.props;
---

{pageKey === 'home' && <HomePage page={page as PageHome} site={site} eventSchedule={eventSchedule} />}
{pageKey === 'story' && <StoryPage page={page as PageStory} />}
{pageKey === 'beliefs' && <BeliefsPage page={page as PageBeliefs} />}
{pageKey === 'ministries' && <MinistriesPage page={page as PageMinistries} site={site} />}
