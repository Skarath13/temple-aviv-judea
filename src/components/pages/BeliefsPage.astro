---
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageBeliefs } from '../../../tina/__generated__/types';
import CmsSections from '../CmsSections.astro';
import PageHero from '../PageHero.astro';
import { cmsImageSource } from '../../lib/cms';

interface Props {
  page: PageBeliefs;
}

const { page } = Astro.props;
const hero = page.hero!;
const banner = page.banner!;
const foundation = page.foundation!;
const unity = page.unity!;
const communityBanner = page.communityBanner!;
const faithIntro = page.faithIntro!;
const pillarsIntro = page.pillarsIntro!;
const prayer = page.prayer!;
const proclamation = page.proclamation!;
const people = page.people!;
const pillarAnchors = new Set(['prayer', 'proclamation', 'people']);
---

<PageHero title={hero.title} intro={hero.intro} accent={hero.accent as 'blue' | 'coral' | 'gold' | 'teal'} data={hero} />

<section class="mosaic-feature mosaic-teal" aria-label="Torah artwork">
  <div class="shell mosaic-frame">
    <img src={cmsImageSource(banner.image)} alt={banner.imageAlt} width="853" height="294" data-tina-field={tinaField(banner, 'image')} />
  </div>
</section>

<section class="section belief-summary">
  <div class="shell split-layout">
    <div>
      <h2 data-tina-field={tinaField(foundation, 'heading')}>{foundation.heading}</h2>
    </div>
    <div class="welcome-copy">
      <p class="lead" data-tina-field={tinaField(foundation, 'lead')}>{foundation.lead}</p>
      <p data-tina-field={tinaField(foundation, 'body')}>{foundation.body}</p>
    </div>
  </div>
</section>

<section class="unity-section">
  <div class="shell unity-callout">
    <blockquote data-tina-field={tinaField(unity, 'quote')}>{unity.quote}</blockquote>
    <cite data-tina-field={tinaField(unity, 'citation')}>{unity.citation}</cite>
    <p data-tina-field={tinaField(unity, 'body')}>{unity.body}</p>
  </div>
</section>

<section class="live-banner-section">
  <figure class="shell belief-banner-card" data-tina-field={tinaField(communityBanner)}>
    <img src={cmsImageSource(communityBanner.image)} alt={communityBanner.imageAlt} width="1800" height="599" loading="lazy" data-tina-field={tinaField(communityBanner, 'image')} />
    <figcaption data-tina-field={tinaField(communityBanner, 'caption')}>{communityBanner.caption}</figcaption>
  </figure>
</section>

<section class="belief-grid-section">
  <div class="shell">
    <div class="section-heading faith-heading">
      <h2 data-tina-field={tinaField(faithIntro, 'heading')}>{faithIntro.heading}</h2>
      <p data-tina-field={tinaField(faithIntro, 'intro')}>{faithIntro.intro}</p>
    </div>
    <div class="belief-grid">
      {page.faithStatements?.map((statement) => statement && (
        <article data-tina-field={tinaField(statement)}>
          <h3 data-tina-field={tinaField(statement, 'title')}>{statement.title}</h3>
          <p data-tina-field={tinaField(statement, 'body')}>{statement.body}</p>
          <p class="scripture-references" data-tina-field={tinaField(statement, 'references')}><strong>Scripture</strong>{statement.references}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="pillars-section">
  <div class="shell">
    <div class="section-heading centered light">
      <h2 data-tina-field={tinaField(pillarsIntro, 'heading')}>{pillarsIntro.heading}</h2>
      <p data-tina-field={tinaField(pillarsIntro, 'intro')}>{pillarsIntro.intro}</p>
    </div>
    <div class="pillars-grid">
      {page.pillars?.map((pillar) => pillar && pillarAnchors.has(pillar.kind) && (
        <a class="pillar-card" href={`#${pillar.kind}`} data-tina-field={tinaField(pillar)}>
          <img class="pillar-card-art" src={cmsImageSource(pillar.image)} alt="" width="720" height="640" loading="lazy" data-tina-field={tinaField(pillar, 'image')} />
          <strong data-tina-field={tinaField(pillar, 'title')}>{pillar.title}</strong>
          <p data-tina-field={tinaField(pillar, 'body')}>{pillar.body}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="core-values-detail-section">
  <div class="shell core-values-detail">
    <article class="core-value-detail" id="prayer">
      <header>
        <h2 data-tina-field={tinaField(prayer, 'heading')}>{prayer.heading}</h2>
      </header>
      <div class="core-value-copy">
        <p class="lead" data-tina-field={tinaField(prayer, 'lead')}>{prayer.lead}</p>
        <p class="scripture-line" data-tina-field={tinaField(prayer, 'scripture')}>{prayer.scripture}</p>
        <ul class="prayer-practices" aria-label="Our practices in prayer">
          {prayer.practices?.map((practice) => practice && <li data-tina-field={tinaField(practice)}><strong data-tina-field={tinaField(practice, 'title')}>{practice.title}</strong><span data-tina-field={tinaField(practice, 'text')}>{practice.text}</span></li>)}
        </ul>
      </div>
    </article>

    <article class="core-value-detail" id="proclamation">
      <header>
        <h2 data-tina-field={tinaField(proclamation, 'heading')}>{proclamation.heading}</h2>
      </header>
      <div class="core-value-copy value-detail-grid">
        {proclamation.sections?.map((section) => section && (
          <section data-tina-field={tinaField(section)}>
            <h3 data-tina-field={tinaField(section, 'heading')}>{section.heading}</h3>
            {section.paragraphs?.map((paragraph) => <p data-tina-field={tinaField(section, 'paragraphs')}>{paragraph}</p>)}
            <p class="scripture-line" data-tina-field={tinaField(section, 'scripture')}>{section.scripture}</p>
          </section>
        ))}
      </div>
    </article>

    <article class="core-value-detail" id="people">
      <header>
        <h2 data-tina-field={tinaField(people, 'heading')}>{people.heading}</h2>
      </header>
      <div class="core-value-copy value-detail-grid people-detail-grid">
        {people.sections?.map((section) => section && (
          <section data-tina-field={tinaField(section)}>
            <h3 data-tina-field={tinaField(section, 'heading')}>{section.heading}</h3>
            {section.paragraphs?.map((paragraph) => <p data-tina-field={tinaField(section, 'paragraphs')}>{paragraph}</p>)}
            {section.scripture && <p class="scripture-line" data-tina-field={tinaField(section, 'scripture')}>{section.scripture}</p>}
          </section>
        ))}
      </div>
    </article>
  </div>
</section>

<CmsSections sections={page.sections} />
