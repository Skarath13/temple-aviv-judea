---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import type { PageKey } from '../../data/pages';
import { cmsEnabled, getPage } from '../../lib/tina/data';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mobileHeroMedia } from '../../lib/hero-media';
import { pageIslandWrapper } from '../../lib/tina/islands';
import EditablePage from './EditablePage.astro';

interface Props {
  pageKey: PageKey;
}

const { pageKey } = Astro.props;
const page = await getPage(pageKey);
const seo = page.seo;

if (!seo) {
  throw new Error(`The ${pageKey} page is missing required SEO settings.`);
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  image={seo.image || undefined}
  preloadImage={pageKey === 'home' ? mobileHeroMedia.poster : undefined}
  preloadImageMedia={pageKey === 'home' ? '(max-width: 760px)' : undefined}
  preloadImageType={pageKey === 'home' ? 'image/webp' : undefined}
>
  {cmsEnabled ? (
    <TinaIsland name="page" wrapper={pageIslandWrapper} params={{ page: pageKey }} primary>
      <EditablePage page={page} pageKey={pageKey} />
    </TinaIsland>
  ) : (
    <EditablePage page={page} pageKey={pageKey} />
  )}
</BaseLayout>
