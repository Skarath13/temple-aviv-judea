---
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageMinistries, SiteSettingsQuery } from '../../../tina/__generated__/types';
import CmsSections from '../CmsSections.astro';
import PageHero from '../PageHero.astro';
import SiteIcon from '../SiteIcon.astro';
import { cmsEtsyLink, cmsImageSource, cmsLink } from '../../lib/cms';

interface Props {
  page: PageMinistries;
  site: SiteSettingsQuery['siteSettings'];
}

const { page, site } = Astro.props;
const hero = page.hero!;
const bibleStudy = page.bibleStudy!;
const artistFeature = page.artistFeature!;
const callToAction = page.callToAction!;
const cardStyles = new Set(['coral', 'blue', 'gold', 'teal']);
const ctaUrl = cmsLink(callToAction.buttonUrl);
const bibleStudyHref = cmsLink(`mailto:${site.email}?subject=${encodeURIComponent(bibleStudy.emailSubject)}`);
const etsyUrl = cmsEtsyLink(site.baruchDesignsEtsy);
const artistContactUrl = cmsLink(artistFeature.contactUrl);
---

<PageHero eyebrow={hero.eyebrow} title={hero.title} intro={hero.intro} accent={hero.accent as 'blue' | 'coral' | 'gold' | 'teal'} data={hero} />

<section class="section ministries-grid-section">
  <div class="shell ministry-card-grid" data-stagger>
    {page.ministryCards?.map((card) => {
      if (!card || !cardStyles.has(card.style)) return null;
      const link = cmsLink(card.linkUrl || undefined);
      return (
        <article class={`ministry-card has-photo ${card.style}-card`} data-tina-field={tinaField(card)}>
          <img src={cmsImageSource(card.image)} alt={card.imageAlt} width="1200" height="750" loading="lazy" data-tina-field={tinaField(card, 'image')} />
          <div class="ministry-card-body">
            <span class="eyebrow" data-tina-field={tinaField(card, 'eyebrow')}>{card.eyebrow}</span>
            <h2 data-tina-field={tinaField(card, 'title')}>{card.title}</h2>
            <p data-tina-field={tinaField(card, 'body')}>{card.body}</p>
            {link && card.linkLabel && <a class="arrow-link" href={link} target={link.startsWith('http') ? '_blank' : undefined} rel={link.startsWith('http') ? 'noreferrer' : undefined} aria-label={link.startsWith('http') ? `${card.linkLabel}. Opens in a new tab.` : undefined} data-tina-field={tinaField(card, 'linkLabel')}>{card.linkLabel} {link.startsWith('http') && <SiteIcon name="external-link" size={18} />}</a>}
          </div>
        </article>
      );
    })}

    <article class="ministry-card blue-card wide-card study-card" data-tina-field={tinaField(bibleStudy)}>
      <span class="ministry-symbol"><SiteIcon name="book" size={30} /></span>
      <div>
        <span class="eyebrow" data-tina-field={tinaField(bibleStudy, 'eyebrow')}>{bibleStudy.eyebrow}</span>
        <h2 data-tina-field={tinaField(bibleStudy, 'heading')}>{bibleStudy.heading}</h2>
        <p data-tina-field={tinaField(bibleStudy, 'body')}>{bibleStudy.body}</p>
        {bibleStudyHref && <a class="arrow-link" href={bibleStudyHref} data-tina-field={tinaField(bibleStudy, 'linkLabel')}>{bibleStudy.linkLabel} <SiteIcon name="arrow-right" size={18} /></a>}
      </div>
    </article>

    <article id="creative-arts" class="ministry-card purple-card wide-card" data-tina-field={tinaField(artistFeature)}>
      <div class="artist-thumbnails">
        {artistFeature.artworks?.map((artwork) => artwork && (
          <figure data-tina-field={tinaField(artwork)}>
            <img src={cmsImageSource(artwork.image)} alt={artwork.imageAlt} width="929" height="1200" loading="lazy" data-tina-field={tinaField(artwork, 'image')} />
            <figcaption><strong data-tina-field={tinaField(artwork, 'title')}>{artwork.title}</strong><span data-tina-field={tinaField(artwork, 'credit')}>{artwork.credit}</span></figcaption>
          </figure>
        ))}
      </div>
      <div>
        <span class="eyebrow eyebrow-light" data-tina-field={tinaField(artistFeature, 'eyebrow')}>{artistFeature.eyebrow}</span>
        <h2 data-tina-field={tinaField(artistFeature, 'heading')}>{artistFeature.heading}</h2>
        <p data-tina-field={tinaField(artistFeature, 'body')}>{artistFeature.body}</p>
      </div>
      <div class="artist-actions">
        {etsyUrl && <a class="button button-ghost-light" href={etsyUrl} target="_blank" rel="noreferrer" aria-label={`${artistFeature.buttonLabel}. Opens in a new tab.`} data-tina-field={tinaField(site, 'baruchDesignsEtsy')}><span data-tina-field={tinaField(artistFeature, 'buttonLabel')}>{artistFeature.buttonLabel}</span> <SiteIcon name="external-link" size={18} /></a>}
        {artistContactUrl && <a class="arrow-link" href={artistContactUrl} data-tina-field={tinaField(artistFeature, 'contactLabel')}>{artistFeature.contactLabel} <SiteIcon name="arrow-right" size={18} /></a>}
      </div>
    </article>
  </div>
</section>

<section class="cta-section">
  <div class="shell cta-inner" data-stagger>
    <div>
      <span class="eyebrow" data-tina-field={tinaField(callToAction, 'eyebrow')}>{callToAction.eyebrow}</span>
      <h2 data-tina-field={tinaField(callToAction, 'heading')}>{callToAction.heading}</h2>
      <p data-tina-field={tinaField(callToAction, 'body')}>{callToAction.body}</p>
    </div>
    {ctaUrl && <a class="button" href={ctaUrl} data-tina-field={tinaField(callToAction, 'buttonLabel')}>{callToAction.buttonLabel}</a>}
  </div>
</section>

<CmsSections sections={page.sections} />
