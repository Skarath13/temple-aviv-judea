---
import type { EventScheduleData, UpcomingEvent } from '../data/events';
import { tinaField } from '@tinacms/astro/tina-field';
import { cmsLink } from '../lib/cms';
import { cmsImageSource } from '../lib/cms';
import SiteIcon from './SiteIcon.astro';

interface Props {
  events: readonly UpcomingEvent[];
  schedule: EventScheduleData;
}

const { events, schedule } = Astro.props;
const visibleEvents = events.slice(0, 3);
const copy = schedule.sectionCopy!;
const formatStart = (startsAt: string) => new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
  timeZoneName: 'short',
  timeZone: 'America/Los_Angeles',
}).format(new Date(startsAt));
---

{visibleEvents.length > 0 && (
  <section class="section upcoming-events-section" aria-labelledby="upcoming-events-title" data-upcoming-events-section>
    <div class="shell">
      <div class="section-heading light" data-reveal>
        <span class="eyebrow eyebrow-light" data-tina-field={tinaField(copy, 'eyebrow')}>{copy.eyebrow}</span>
        <h2 id="upcoming-events-title" data-tina-field={tinaField(copy, 'heading')}>{copy.heading}</h2>
        <p data-tina-field={tinaField(copy, 'intro')}>{copy.intro}</p>
      </div>
      <div class="upcoming-events-grid" data-stagger>
        {visibleEvents.map((event) => (
          <article class="upcoming-event-card" data-event-ends-at={event.endsAt} data-tina-field={tinaField(event.source)}>
            <div class="upcoming-event-image">
              <img src={cmsImageSource(event.image.src)} alt={event.image.alt} width="1200" height="800" loading="lazy" data-tina-field={tinaField(event.source, 'image')} />
            </div>
            <div class="upcoming-event-copy">
              <span class="event-date" data-tina-field={tinaField(event.source, 'startsAt')}><SiteIcon name="calendar-event" size={19} /> <time datetime={event.startsAt}>{formatStart(event.startsAt)}</time></span>
              <h3 data-tina-field={tinaField(event.source, 'title')}>{event.title}</h3>
              <p data-tina-field={tinaField(event.source, 'summary')}>{event.summary}</p>
              <span class="event-location" data-tina-field={tinaField(event.source, 'location')}><SiteIcon name="map-pin" size={18} /> {event.location}</span>
              {cmsLink(event.detailsUrl) && <a class="button button-gold" href={cmsLink(event.detailsUrl)} data-tina-field={tinaField(event.source, 'detailsUrl')}><span data-tina-field={tinaField(copy, 'detailsLabel')}>{copy.detailsLabel}</span></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{visibleEvents.length === 0 && (
  <section
    class="section upcoming-events-section tina-empty-events"
    aria-labelledby="empty-upcoming-events-title"
    data-tina-field={tinaField(schedule, 'events')}
  >
    <div class="shell">
      <div class="section-heading light">
        <span class="eyebrow eyebrow-light" data-tina-field={tinaField(copy, 'eyebrow')}>{copy.eyebrow}</span>
        <h2 id="empty-upcoming-events-title" data-tina-field={tinaField(copy, 'heading')}>{copy.heading}</h2>
        <p>No upcoming events are currently published. Select this section to add the first event.</p>
      </div>
    </div>
  </section>
)}
