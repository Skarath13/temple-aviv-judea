---
import { siteNavigation, type SiteSettingsData } from "../data/site";
import { tinaField } from "@tinacms/astro/tina-field";
import {
	cmsFacebookLink,
	cmsMapsLink,
	cmsLink,
	cmsYouTubeLink,
	cmsPayPalLink,
} from "../lib/cms";
import { formatPublicHours } from "../lib/site-structured-data.mjs";
import { withBase } from "../lib/urls";
import SiteIcon from "./SiteIcon.astro";

interface Props {
	site: SiteSettingsData;
}

const { site } = Astro.props;
const navItems = siteNavigation(site);
const address = site.address!;
const mapsUrl = cmsMapsLink(address.maps);
const phoneUrl = cmsLink(site.phoneHref);
const emailUrl = cmsLink(`mailto:${site.email}`);
const youtubeUrl = cmsYouTubeLink(site.youtube);
const facebookUrl = cmsFacebookLink(site.facebook);
const adminPath =
	import.meta.env.BASE_URL === "/" ? "/admin/" : "/admin-preview/";
const publicHours = formatPublicHours(site.publicHours);
const givingUrl = cmsPayPalLink(site.giving);
---

<footer class="site-footer">
  <div class="footer-art" aria-hidden="true"></div>
  <div class="shell footer-grid" data-stagger>
    <div class="footer-intro">
      <span class="eyebrow eyebrow-light" data-tina-field={tinaField(site.footerCopy, 'eyebrow')}>{site.footerCopy.eyebrow}</span>
      <h2 data-tina-field={tinaField(site.footerCopy, 'heading')}>{site.footerCopy.heading}</h2>
      <p data-tina-field={tinaField(site.footerCopy, 'body')}>{site.footerCopy.body}</p>
      <a class="paypal-give-button" href={givingUrl} target="_blank" rel="noreferrer" aria-label={`Donate with PayPal. Opens in a new tab.`} data-tina-field={tinaField(site, 'giving')}>
                    <span><SiteIcon name="brand-paypal" size={27} /><span class="paypal-button-copy"><small>Donate with PayPal</small></span></span>
                    <SiteIcon name="external-link" size={18} />
                  </a>
    </div>

    <div>
      <h3 data-tina-field={tinaField(site.footerCopy, 'exploreHeading')}>{site.footerCopy.exploreHeading}</h3>
      <ul class="footer-links">
        {navItems.slice(1).map((item) => {
          const href = cmsLink(item.href);
          return href && <li><a href={href} data-tina-field={tinaField(item)}>{item.label}</a></li>;
        })}
      </ul>
    </div>

    <div>
      <h3 data-tina-field={tinaField(site.footerCopy, 'connectHeading')}>{site.footerCopy.connectHeading}</h3>
      <address>
        {mapsUrl && <a href={mapsUrl} target="_blank" rel="noreferrer" data-tina-field={tinaField(address, 'maps')}><span data-tina-field={tinaField(address, 'street')}>{address.street}</span><br /><span data-tina-field={tinaField(address, 'city')}>{address.city}</span></a>}
        <span class="public-hours" data-tina-field={tinaField(site, 'publicHours')}><small>Public hours</small>{publicHours}</span>
        <span class="mailing-address" data-tina-field={tinaField(address, 'mailing')}><small>Mailing address</small>{address.mailing}</span>
        {phoneUrl && <a href={phoneUrl} data-tina-field={tinaField(site, 'phone')}>{site.phone}</a>}
        {emailUrl && <a href={emailUrl} data-tina-field={tinaField(site, 'email')}>{site.email}</a>}
      </address>
      <div class="social-links">
        {youtubeUrl && <a href={youtubeUrl} target="_blank" rel="noreferrer" data-tina-field={tinaField(site, 'youtube')}><SiteIcon name="brand-youtube" size={18} /> YouTube</a>}
        {facebookUrl && <a href={facebookUrl} target="_blank" rel="noreferrer" data-tina-field={tinaField(site, 'facebook')}><SiteIcon name="brand-facebook" size={18} /> Facebook</a>}
      </div>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span class="footer-bottom-links"><span data-tina-field={tinaField(site.footerCopy, 'motto')}>{site.footerCopy.motto}</span><a class="footer-admin-link" href={withBase(adminPath)}><SiteIcon name="lock" size={14} />Admin</a></span>
  </div>
</footer>
