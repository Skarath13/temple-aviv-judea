{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "temple-aviv-judea",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": [
      "/videos/hero/*.mp4",
      "/videos/hero/*.webm"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "b8711c2ee9344dc689033a6c4fba823c"
    }
  ],
  "observability": {
    "enabled": true
  }
}
